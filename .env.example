# Copy to .env (never commit .env). Set the same values in Vercel > Project > Settings > Environment Variables.

# Server-only. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override of the Gemini model
GEMINI_MODEL=gemini-3.8-flash

# Browser key for Google Maps JavaScript API + Places API.
# This is visible in the browser by design: restrict it to your domains
# (localhost:5173 and your *.vercel.app URL) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
