# Copy to .env for local dev (never commit .env). Set the same in Vercel → Settings → Environment Variables.

# Server-only: Gemini assistant. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Browser key for Google Maps JavaScript API (restrict by website in Google Cloud).
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (accounts, saved places). Publishable values from the Supabase/Lovable project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
